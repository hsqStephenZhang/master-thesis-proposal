@@ -0,0 +1,26 @@
+"""Run warm end-to-end calls after builds finish; verify against double first."""
+import json
+import os
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parent
+REPO = ROOT.parents[2]
+RESULTS = ROOT / 'results'
+RESULTS.mkdir(exist_ok=True)
+CACHE = REPO / '.test/conv-im2col-batch/references'
+CACHE.mkdir(parents=True, exist_ok=True)
+configs = [(1,1), (1,4), (4,1), (4,4)]
+events = []
+for repeat in range(3):
+    order = configs[repeat:] + configs[:repeat]
+    for batch, threads in order:
+        name = f'b{batch}-t{threads}-r{repeat+1}'
+        binary = REPO / f'.test/winograd/bench-b{batch}-t{threads}/bench'
+        print(name, flush=True)
+        with (RESULTS / f'{name}.csv').open('w') as out, (RESULTS / f'{name}.log').open('w') as err:
+            run = subprocess.run([str(binary)], stdout=out, stderr=err, env=dict(os.environ, MIM_NUM_THREADS=str(threads), CONV_REFERENCE_CACHE=str(CACHE)), timeout=1200)
+        events.append(dict(name=name, binary=str(binary), returncode=run.returncode))
+        (RESULTS / 'execution.json').write_text(json.dumps(events, indent=2)+'\n')
+        if run.returncode:
+            raise RuntimeError(name)
diff --git a/docs/benchmarks/conv-winograd/summarize.py b/docs/benchmarks/conv-winograd/summarize.py
new file mode 100644

@@ -0,0 +1,19 @@
+import csv
+from pathlib import Path
+from statistics import median
+
+root = Path(__file__).resolve().parent
+rows = {}
+for path in sorted((root / 'results').glob('*.csv')):
+    for row in csv.DictReader(path.open()):
+        key = (row['case'], int(row['N']), int(row['threads']), row['variant'])
+        rows.setdefault(key, []).append(float(row['median_ms']))
+lines = ['| Shape (N,Cin,Cout,H,W) | Threads | Direct ms | Im2col ms | Winograd ms | Direct / Winograd |', '|---|---:|---:|---:|---:|---:|']
+for n in (1,4):
+    for t in (1,4):
+        for name,ci,co,h,w in [('small_16',16,16,32,32),('resnet_32_64',32,64,28,28),('resnet_128',128,128,28,28),('vgg_512',512,512,7,7),('k27',3,64,32,32),('odd',13,17,17,19)]:
+            vals = [median(rows[(name,n,t,v)]) for v in ('direct','trans_im2col','winograd')]
+            assert all(len(rows[(name,n,t,v)]) == 3 for v in ('direct','trans_im2col','winograd'))
+            lines.append(f'| {n},{ci},{co},{h},{w} | {t} | {vals[0]:.4f} | {vals[1]:.4f} | {vals[2]:.4f} | {vals[0]/vals[2]:.2f}× |')
+(root / 'table.md').write_text('\n'.join(lines)+'\n')
+print('\n'.join(lines))
diff --git a/lit/tensor/literal_buffer_aux.cpp b/lit/tensor/literal_buffer_aux.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..f621bc03f7bff29df34aefdbd9a3a19c5a19351a
--- /dev/null
+++ b/lit/tensor/literal_buffer_aux.cpp
@@ -0,0 +1,30 @@
+#include <cmath>
+#include <cstdlib>
+
+extern "C" {
+float* literal2(float*);
+float* literal3(float*);
+float* splat2(float*);
+float* splat3(float*);
+float* scalar_pad(float);
+}
+int main() {
+    float x[]  = {1, 2, 3, 4, 5, 6};
+    auto check = [&](float* (*f)(float*), int rows, bool splat) {
+        auto y  = f(x);
+        int bad = 0;
+        for (int i = 0; i < rows; ++i)
+            for (int j = 0; j < 2; ++j) {
+                float ref = splat ? x[2 * i] + x[2 * i + 1] : x[2 * i] * (j + 1) + x[2 * i + 1] * (j + 3);
+                bad += !std::isfinite(y[2 * i + j]) || y[2 * i + j] != ref;
+            }
+        std::free(y);
+        return bad;
+    };
+    int bad = check(literal2, 2, false) + check(literal3, 3, false) + check(splat2, 2, true) + check(splat3, 3, true);
+    auto p  = scalar_pad(0.73f);
+    for (int i = 0; i < 9; ++i)
+        bad += p[i] != (i == 4 ? 0.73f : 0.0f);
+    std::free(p);
+    return bad != 0;
+}
diff --git a/lit/tensor/literal_buffer_exec.mim b/lit/tensor/literal_buffer_exec.mim
new file mode 100644
index 0000000000000000000000000000000000000000..c61c81213185b0a853cadce63aa2c2fbd3079aa4
--- /dev/null
+++ b/lit/tensor/literal_buffer_exec.mim
@@ -0,0 +1,17 @@
+// RUN: rm -f %{s:stem}.ll
+// RUN: %mim -p opt -p clos %s -p ll
+// RUN: clang++ -std=c++23 %S/literal_buffer_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
+// RUN: %t
+
+// Materializing the same literal in different functions must anchor each allocation to that function's memory.
+// A fully singleton pad input still needs a rank-zero buffer, although its value type is scalar.
+plugin tensor;
+plugin math;
+let F = math.F32;
+let R: tensor.Ring = (F, 0:F, math.arith.add 0, math.arith.mul 0);
+let weight = ((1.0:F, 2.0:F), (3.0:F, 4.0:F));
+extern fun literal2 (x: «2,2; F»): «2,2; F» = return (tensor.product_2d R (tensor.buf x, weight));
+extern fun literal3 (x: «3,2; F»): «3,2; F» = return (tensor.product_2d R (tensor.buf x, weight));
+extern fun splat2 (x: «2,2; F»): «2,2; F» = return (tensor.product_2d R (tensor.buf x, ‹2,2; 1.0:F›));
+extern fun splat3 (x: «3,2; F»): «3,2; F» = return (tensor.product_2d R (tensor.buf x, ‹2,2; 1.0:F›));
+extern fun scalar_pad (x: F): «3,3; F» = return (tensor.pad @(F,4) (1,1,1,1) (0,(0,0,1,1),(0,0,1,1)) (x,0:F));
diff --git a/lit/tensor/winograd_aux.cpp b/lit/tensor/winograd_aux.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..eeac4fcc606e178773dff68888f1579b7ab6015a
--- /dev/null
+++ b/lit/tensor/winograd_aux.cpp
@@ -0,0 +1,99 @@
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+
+#include <algorithm>
+#include <limits>
+#include <vector>
+
+extern "C" {
+float* even(float*, float*);
+float* odd(float*, float*);
+float* valid(float*, float*);
+float* asym(float*, float*);
+float* channel_one(float*, float*);
+float* channel_tail(float*, float*);
+float* parallel(float*, float*);
+float* packed_tail(float*, float*);
+float* precise(float*, float*);
+float* direct(float*, float*);
+double* fp64(double*, double*);
+float scalar(float, float*);
+}
+
+template<class T>
+int check(const char* name, T* (*kernel)(T*, T*), int n, int ci, int co, int h, int w, int ph, int pw) {
+    int oh = h + 2 * ph - 2, ow = w + 2 * pw - 2;
+    std::vector<T> input(size_t(n) * ci * h * w), weight(size_t(co) * ci * 9);
+    unsigned rng = 42;
+    auto value   = [&]() {
+        rng = rng * 1664525u + 1013904223u;
+        return T(int(rng >> 8) % 2001 - 1000) / T(1000);
+    };
+    for (auto& x : input)
+        x = value();
+    for (auto& x : weight)
+        x = value();
+    // Dense, zero, sparse asymmetric and cancellation-heavy data exercise both axes of all three transforms.
+    for (int pattern = 0; pattern != 4; ++pattern) {
+        if (pattern == 1) std::fill(weight.begin(), weight.end(), T(0));
+        if (pattern == 2)
+            for (size_t i = 0; i < weight.size(); ++i)
+                weight[i] = i % 9 == 2 ? T(0.7) : T(0);
+        if (pattern == 3) {
+            for (size_t i = 0; i < weight.size(); ++i)
+                weight[i] = (i & 1 ? T(-1) : T(1)) + T(i % 7) * T(0.0001);
+            for (size_t i = 0; i < input.size(); ++i)
+                input[i] = T(1) + T(i % 11) * T(0.0001);
+        }
+        auto out = kernel(input.data(), weight.data());
+        for (int b = 0; b < n; ++b)
+            for (int c = 0; c < co; ++c)
+                for (int y = 0; y < oh; ++y)
+                    for (int x = 0; x < ow; ++x) {
+                        double ref = 0, scale = 0;
+                        for (int k = 0; k < ci; ++k)
+                            for (int r = 0; r < 3; ++r)
+                                for (int s = 0; s < 3; ++s) {
+                                    int iy = y + r - ph, ix = x + s - pw;
+                                    if (iy < 0 || iy >= h || ix < 0 || ix >= w) continue;
+                                    double v = double(input[((size_t(b) * ci + k) * h + iy) * w + ix])
+                                             * weight[((size_t(c) * ci + k) * 3 + r) * 3 + s];
+                                    ref += v;
+                                    scale += std::abs(v);
+                                }
+                        auto index       = ((size_t(b) * co + c) * oh + y) * ow + x;
+                        double tolerance = (sizeof(T) == sizeof(float) ? 2e-5 : 2e-12) * (1 + scale);
+                        if (!std::isfinite(out[index]) || std::abs(double(out[index]) - ref) > tolerance) {
+                            std::fprintf(stderr, "%s pattern %d at %zu: %.17g vs %.17g (bound %.3g)\n", name, pattern,
+                                         index, double(out[index]), ref, tolerance);
+                            std::free(out);
+                            return 1;
+                        }
+                    }
+        std::free(out);
+    }
+    return 0;
+}
+
+int main() {
+    int bad = 0;
+    bad += check("even", even, 2, 3, 5, 6, 8, 1, 1);
+    bad += check("odd", odd, 1, 3, 4, 5, 7, 1, 1);
+    bad += check("valid", valid, 3, 2, 3, 5, 7, 0, 0);
+    bad += check("asym", asym, 2, 3, 2, 5, 4, 2, 0);
+    bad += check("channel_one", channel_one, 2, 1, 1, 3, 4, 1, 1);
+    bad += check("channel_tail", channel_tail, 2, 13, 17, 9, 11, 1, 1);
+    bad += check("parallel", parallel, 2, 64, 64, 16, 16, 1, 1);
+    bad += check("packed_tail", packed_tail, 1, 130, 64, 16, 16, 1, 1);
+    bad += check("precise", precise, 1, 3, 4, 5, 7, 1, 1);
+    bad += check("fp64", fp64, 2, 3, 5, 5, 7, 1, 1);
+    bad += check("direct", direct, 1, 3, 4, 5, 7, 1, 1);
+    float weight[] = {0.2f, -0.3f, 0.4f, -0.5f, 0.6f, -0.7f, 0.8f, -0.9f, 1.0f};
+    float got = scalar(0.73f, weight), ref = 0.73f * weight[4];
+    if (!std::isfinite(got) || std::abs(got - ref) > 1e-6f) {
+        std::fprintf(stderr, "scalar: %.9g vs %.9g\n", got, ref);
+        ++bad;
+    }
+    return bad != 0;
+}

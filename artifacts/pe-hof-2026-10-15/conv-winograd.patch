diff --git a/lit/tensor/winograd_exec.mim b/lit/tensor/winograd_exec.mim
new file mode 100644
index 0000000000000000000000000000000000000000..0b1cc3b4d215ef36ab0d4564d8dd6a690f0854ed
--- /dev/null
+++ b/lit/tensor/winograd_exec.mim
@@ -0,0 +1,42 @@
+// RUN: rm -f %{s:stem}.ll
+// RUN: %mim -p opt -p clos -X tensor:threads=4 -X tensor:schedule_report=%t.jsonl %s -p ll
+// RUN: python3 %S/winograd_schedule_check.py %t.jsonl
+// RUN: clang++ -std=c++23 -O3 %S/winograd_aux.cpp %{s:stem}.ll -o %t -Wno-override-module
+// RUN: MIM_NUM_THREADS=1 %t
+// RUN: MIM_NUM_THREADS=4 %t
+
+// Winograd F(2x2, 3x3) vs double scalar cross-correlation and direct tensor.conv.
+// Cover singleton axes, multiple batches, asymmetric padding, odd output tiles, channel tails and FP64.
+plugin tensor;
+plugin math;
+let F = math.F32;
+let fast = math.mode.fast;
+
+extern fun even (x: «2,3,6,8; F», w: «5,3,3,3; F»): «2,5,6,8; F» =
+    return (tensor.trans.winograd fast @math.f32 @(2,3,5,6,8,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun odd (x: «1,3,5,7; F», w: «4,3,3,3; F»): «1,4,5,7; F» =
+    return (tensor.trans.winograd fast @math.f32 @(1,3,4,5,7,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun valid (x: «3,2,5,7; F», w: «3,2,3,3; F»): «3,3,3,5; F» =
+    return (tensor.trans.winograd fast @math.f32 @(3,2,3,5,7,3,3) ((1,1),(1,1),(0,0)) (tensor.buf x, tensor.buf w));
+extern fun asym (x: «2,3,5,4; F», w: «2,3,3,3; F»): «2,2,7,2; F» =
+    return (tensor.trans.winograd fast @math.f32 @(2,3,2,5,4,3,3) ((1,1),(1,1),(2,0)) (tensor.buf x, tensor.buf w));
+extern fun channel_one (x: «2,1,3,4; F», w: «1,1,3,3; F»): «2,1,3,4; F» =
+    return (tensor.trans.winograd fast @math.f32 @(2,1,1,3,4,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun channel_tail (x: «2,13,9,11; F», w: «17,13,3,3; F»): «2,17,9,11; F» =
+    return (tensor.trans.winograd fast @math.f32 @(2,13,17,9,11,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun parallel (x: «2,64,16,16; F», w: «64,64,3,3; F»): «2,64,16,16; F» =
+    return (tensor.trans.winograd fast @math.f32 @(2,64,64,16,16,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun packed_tail (x: «1,130,16,16; F», w: «64,130,3,3; F»): «1,64,16,16; F» =
+    return (tensor.trans.winograd fast @math.f32 @(1,130,64,16,16,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun precise (x: «1,3,5,7; F», w: «4,3,3,3; F»): «1,4,5,7; F» =
+    return (tensor.trans.winograd math.mode.none @math.f32 @(1,3,4,5,7,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+extern fun fp64 (x: «2,3,5,7; math.F64», w: «5,3,3,3; math.F64»): «2,5,5,7; math.F64» =
+    return (tensor.trans.winograd math.mode.none @math.f64 @(2,3,5,5,7,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));
+
+// All result axes fold away: the C ABI returns a scalar, and input x is scalar too.
+extern fun scalar (x: F, w: «1,1,3,3; F»): F =
+    return (tensor.trans.winograd fast @math.f32 @(1,1,1,1,1,3,3) ((1,1),(1,1),(1,1)) (x, tensor.buf w));
+
+let R: tensor.Ring = (F, 0:F, math.arith.add fast, math.arith.mul fast);
+extern fun direct (x: «1,3,5,7; F», w: «4,3,3,3; F»): «1,4,5,7; F» =
+    return (tensor.conv R @(1,3,4,5,7,3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));

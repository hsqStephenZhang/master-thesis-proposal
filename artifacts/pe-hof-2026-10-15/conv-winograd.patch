diff --git a/lit/tensor/winograd_schedule_check.py b/lit/tensor/winograd_schedule_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..ba7f24d230762fa6c929957e0b972d48ca39fe41
--- /dev/null
+++ b/lit/tensor/winograd_schedule_check.py
@@ -0,0 +1,15 @@
+import json
+import sys
+
+with open(sys.argv[1], encoding="utf-8") as f:
+    rows = [json.loads(line) for line in f]
+
+# Each transform component contracts channels independently; suitable shapes retain GEMM register blocks.
+blocks = [row for row in rows if row["nest"] == "register_blocked"]
+assert blocks and all(row["register_block"] == [4, 16] for row in blocks), blocks
+# The 64-channel batch=2 case has an immutable transformed input and parallel transform-plane tasks.
+assert any(row["parallel_tasks"] == 16 for row in blocks), blocks
+# Packed K=130 keeps its two-point remainder, rather than reading past the channel axis.
+assert any(row["schedule"]["tail"] == 2 for row in blocks), blocks
+# Input transformation really materializes 4x4 components including the extra point of each odd tile.
+assert any(row["So"] == [4, 4, 3, 1, 3, 4] for row in rows), rows

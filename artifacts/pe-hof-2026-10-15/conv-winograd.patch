+++ b/docs/benchmarks/conv-winograd/build.py
@@ -0,0 +1,48 @@
+"""Build three end-to-end convolution variants using the same current compiler."""
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+REPO = ROOT.parents[2]
+CASES = [
+    ('small_16', 16, 16, 32, 32),
+    ('resnet_32_64', 32, 64, 28, 28),
+    ('resnet_128', 128, 128, 28, 28),
+    ('vgg_512', 512, 512, 7, 7),
+    ('k27', 3, 64, 32, 32),
+    ('odd', 13, 17, 17, 19),
+]
+
+def build(batch, threads):
+    out = REPO / f'.test/winograd/bench-b{batch}-t{threads}'
+    out.mkdir(parents=True, exist_ok=True)
+    source = ['plugin tensor; plugin core; plugin math;',
+              'let F = math.F32;',
+              'let R: tensor.Ring = (F, 0:F, math.arith.add math.mode.fast, math.arith.mul math.mode.fast);']
+    includes = []
+    for name, ci, co, h, w in CASES:
+        for prefix, op in [('direct', 'tensor.conv R'),
+                           ('transform', 'tensor.trans.im2col R'),
+                           ('winograd', 'tensor.trans.winograd math.mode.fast @math.f32')]:
+            source.append(f'extern fun {prefix}_{name} (x: «{batch},{ci},{h},{w}; F», w: «{co},{ci},3,3; F»): «{batch},{co},{h},{w}; F» = return ({op} @({batch},{ci},{co},{h},{w},3,3) ((1,1),(1,1),(1,1)) (tensor.buf x, tensor.buf w));')
+        includes.append('S(' + ','.join(map(str, [name,batch,ci,co,h,w,3,3,1,1,1,1,1,1])) + ')')
+    (out / 'bench.mim').write_text('\n'.join(source) + '\n')
+    (out / 'cases.inc').write_text('\n'.join(includes) + '\n')
+    report = out / 'schedule.jsonl'
+    report.unlink(missing_ok=True)
+    commands = [
+        [str(REPO / 'build/bin/mim'), '-p', 'opt', '-p', 'clos', '-X', f'tensor:threads={threads}', '-X', f'tensor:schedule_report={report}', str(out / 'bench.mim'), '-p', 'll', '-X', f'll:o={out / "bench.ll"}'],
+        ['/Users/zc/courses/compiler/MimIR/.test/par_review/bin/clang++', '-O3', '-mcpu=native', '-std=c++23', '-Wno-override-module', '-I'+str(out), str(ROOT / 'bench.cpp'), str(out / 'bench.ll'), '-o', str(out / 'bench')],
+    ]
+    (out / 'commands.json').write_text(json.dumps(commands, indent=2) + '\n')
+    for i, cmd in enumerate(commands):
+        with (out / f'build{i}.log').open('w') as log:
+            subprocess.run(cmd, stdout=log, stderr=log, check=True, timeout=1200)
+    (out / 'manifest.json').write_text(json.dumps(dict(batch=batch, threads=threads, cases=CASES, compiler_sha256=hashlib.sha256((REPO / 'build/bin/mim').read_bytes()).hexdigest(), tensor_plugin_sha256=hashlib.sha256((REPO / 'build/lib/mim/libmim_tensor.so').read_bytes()).hexdigest(), affine_plugin_sha256=hashlib.sha256((REPO / 'build/lib/mim/libmim_affine.so').read_bytes()).hexdigest(), llvm_sha256=hashlib.sha256((out / 'bench.ll').read_bytes()).hexdigest()), indent=2)+'\n')
+    print(out, flush=True)
+
+if __name__ == '__main__':
+    build(int(sys.argv[1]), int(sys.argv[2]))

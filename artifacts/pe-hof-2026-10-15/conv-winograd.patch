+                                    }
+                        }
+            if (!cache_path.empty()) {
+                auto file = std::fopen(cache_path.c_str(), "wb");
+                bool ok   = file && std::fwrite(header, sizeof(header), 1, file) == 1
+                         && std::fwrite(ref.data(), sizeof(double), cells, file) == cells
+                         && std::fwrite(scale.data(), sizeof(double), cells, file) == cells;
+                if (file) ok = (std::fclose(file) == 0) && ok;
+                if (!ok) {
+                    std::fprintf(stderr, "cannot write reference cache %s\n", cache_path.c_str());
+                    return 1;
+                }
+            }
+        }
+        std::fprintf(stderr, "%s batch=%d reference=%s\n", c.name, c.n, cached ? "cached" : "computed");
+        Kernel funcs[]   = {c.direct, c.transform, c.winograd};
+        int variants     = 3;
+        double errors[3] = {};
+        for (int v = 0; v < variants; ++v) {
+            auto out = funcs[v](x.data(), w.data());
+            for (size_t i = 0; i < cells; ++i) {
+                double e  = std::abs(double(out[i]) - ref[i]);
+                errors[v] = std::max(errors[v], e);
+                if (!std::isfinite(out[i]) || e > 2e-5 * (1 + scale[i])) {
+                    std::fprintf(stderr, "%s variant %d incorrect at %zu: %.9g vs %.9g\n", c.name, v, i, out[i],
+                                 ref[i]);
+                    return 1;
+                }
+            }
+            std::free(out);
+        }
+        auto batch = [&](int v, int reps) {
+            auto start = Clock::now();
+            for (int i = 0; i < reps; ++i) {
+                auto out = funcs[v](x.data(), w.data());
+                checksum += out[size_t(i) % cells];
+                std::free(out);
+            }
+            return std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+        };
+        int reps[3];
+        std::vector<double> samples[3];
+        for (int v = 0; v < variants; ++v) {
+            int count = 1;
+            double ms;
+            while ((ms = batch(v, count)) < 1 && count < (1 << 18))
+                count *= 2;
+            reps[v] = std::clamp(int(5 * count / ms), 1, 1 << 20);
+        }
+        for (int round = 0; round < 7; ++round)
+            for (int order = 0; order < variants; ++order) {
+                int v = (round + order) % variants;
+                samples[v].push_back(batch(v, reps[v]) / reps[v]);
+            }
+        for (int v = 0; v < variants; ++v) {
+            auto& s = samples[v];
+            std::sort(s.begin(), s.end());
+            double ms    = s[s.size() / 2];
+            double flops = 2.0 * cells * c.ci * c.kh * c.kw;
+            std::printf("%s,%d,%d,%d,%d,%d,%d,%d,%s,%s,%.9f,%.6f,%.6f,%.6f,%.9g\n", c.name, c.n, c.ci, c.co, c.h, c.w,
+                        c.kh, c.kw, threads ? threads : "unset", (v == 2 ? "winograd" : v == 1 ? "trans_im2col" : "direct"), ms, ms * 1000 / c.n,
+                        c.n * 1000 / ms, flops / (ms * 1e6), errors[v]);
+        }
+    }
+    std::fprintf(stderr, "checksum=%.9g\n", checksum);
+}
diff --git a/docs/benchmarks/conv-winograd/build.py b/docs/benchmarks/conv-winograd/build.py
